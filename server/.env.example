# Copy to server/.env and fill in what you need. Everything is optional in development.

PORT=5000
JWT_SECRET=change-me-to-a-long-random-string

# Enables Claude for natural-language scheduling + weekly insights.
# Without it, the app uses its built-in offline rule-based engine.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# AI_RATE_LIMIT_PER_MIN=15

# Optional email reminders (any SMTP provider, e.g. Gmail app password, Mailtrap, Resend SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
